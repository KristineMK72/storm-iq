---
import Layout from "../layouts/Layout.astro";
import HomeBase from "../components/HomeBase";
import TargetBoard from "../components/TargetBoard";
import ChaseScore from "../components/ChaseScore";
import UpcomingPotential from "../components/UpcomingPotential";
import FutureOutlookMap from "../components/FutureOutlookMap";
---

<Layout title="Storm IQ | Targets">

  <div class="page-head">

    <div class="eyebrow">
      Chase targeting
    </div>

    <h1>
      TARGETS
    </h1>

    <p>
      Ranked live threats across the contiguous U.S.,
      with optional drive-time estimates from your home base.
      Tap any target for the full official warning text.
      Official NWS warnings always take priority.
    </p>

  </div>

  <HomeBase client:only="react" />

  <div class="grid dashboard-grid">
    <ChaseScore client:only="react" />
    <TargetBoard client:only="react" />
  </div>

  <UpcomingPotential client:only="react" />

  <div class="card" style="margin-top:18px">
    <div class="section-title">
      <div>
        <div class="eyebrow">Looking ahead</div>
        <h2>Future target areas</h2>
      </div>
      <span class="small muted">DAY 2 / DAY 3 MAP</span>
    </div>
    <p class="muted" style="font-size:13px;line-height:1.55;margin:0 0 14px">
      Potential severe footprints for tomorrow and the day after.
    </p>
    <FutureOutlookMap client:only="react" />
  </div>

</Layout>
