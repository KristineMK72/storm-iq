---
import Layout from "../layouts/Layout.astro";
import StormMap from "../components/StormMap";
import OutlookDiscussion from "../components/OutlookDiscussion";
---

<Layout title="Storm IQ | Map">

  <div class="page-head">

    <div class="eyebrow">
      National operations map
    </div>

    <h1>
      STORM MAP
    </h1>

    <p>
      Live National Weather Service alerts plus the
      official SPC Day 1 convective outlook (look-ahead
      risk areas). Scroll down for the full written discussion.
    </p>

  </div>


  <div class="card">

    <div class="map-shell">

      <StormMap client:only="react" />

    </div>

  </div>


  <OutlookDiscussion client:only="react" />


  <div
    class="notice"
    style="margin-top:18px"
  >

    <strong>
      LIVE DATA:
    </strong>

    Colored regions = SPC Day 1 categorical outlook
    (Marginal → High risk). Dots = active NWS alerts.
    The discussion below is the official SPC text
    explaining the expected threats and timing.
    Official NWS warnings always take priority.

  </div>

</Layout>
