---
import Layout from "../layouts/Layout.astro";
import StormMap from "../components/StormMap";
---

<Layout title="Storm IQ | Map">

  <div class="page-head">

    <div class="eyebrow">
      National operations map
    </div>

    <h1>
      STORM MAP
    </h1>

    <p>
      Live National Weather Service alerts plotted
      across the United States. Click any marker
      for event details, severity, and expiration.
    </p>

  </div>


  <div class="card">

    <div class="map-shell">

      <StormMap client:only="react" />

    </div>

  </div>


  <div
    class="notice"
    style="margin-top:18px"
  >

    <strong>
      LIVE DATA:
    </strong>

    Markers are drawn from the official NWS active
    alerts feed (warnings and high-impact events).
    Color indicates severity. Click a marker for
    full details. Official warnings always take
    priority over any other guidance.

  </div>

</Layout>
