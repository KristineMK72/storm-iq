---
import Layout from "../layouts/Layout.astro";
import ChaseScore from "../components/ChaseScore";
import TargetBoard from "../components/TargetBoard";
import ChaseModeMap from "../components/ChaseModeMap";
import ThreatStrip from "../components/ThreatStrip";
import MesoLinks from "../components/MesoLinks";
---

<Layout title="Storm IQ | Command">

  <section class="hero">
    <div class="hero-copy">
      <span class="hero-tag">NATIONWIDE STORM INTELLIGENCE</span>
      <h1>
        KNOW WHERE<br />
        <span style="color:var(--lime)">THE STORM</span><br />
        IS GOING.
      </h1>
      <p>
        Live map, alerts, and chase targets in one place.
        Forecast models and settings live on their own pages so this stays the ops desk.
      </p>
      <div style="display:flex;flex-wrap:wrap;gap:10px;margin-top:16px">
        <a href="/map" class="chase-btn chase-btn-on" style="text-decoration:none">Open map</a>
        <a href="/forecast" class="chase-btn" style="text-decoration:none">Forecast</a>
        <a href="/settings" class="chase-btn" style="text-decoration:none">Settings</a>
      </div>
    </div>

    <div class="card">
      <div class="eyebrow">System status</div>
      <h2 style="margin-top:7px">Monitoring</h2>
      <p class="muted">National weather environment online.</p>
      <div class="notice" style="margin-top:20px">
        <strong>SAFETY FIRST</strong><br />
        Storm IQ does not replace NWS warnings. If a warning conflicts with a target
        recommendation, follow the official warning and move to safety.
      </div>
    </div>
  </section>

  <ThreatStrip client:only="react" />

  <div class="grid dashboard-grid">
    <ChaseScore client:only="react" />
    <TargetBoard client:only="react" />
  </div>

  <div class="card" style="margin-top:18px">
    <div class="section-title">
      <div>
        <div class="eyebrow">National view</div>
        <h2>Live operations map</h2>
      </div>
      <span class="small muted">CHASE MODE · NWS + SPC</span>
    </div>
    <ChaseModeMap client:only="react" />
  </div>

  <MesoLinks client:only="react" />

  <div class="notice" style="margin-top:18px">
    <strong>Quick links:</strong>
    <a href="/forecast" style="color:var(--lime)">Forecast</a> ·
    <a href="/settings" style="color:var(--lime)">Settings</a> ·
    <a href="/map" style="color:var(--lime)">Full map</a> ·
    <a href="/alerts" style="color:var(--lime)">Alerts</a>
  </div>

</Layout>
