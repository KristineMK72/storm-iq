---
import Layout from "../layouts/Layout.astro";
import ChaseScore from "../components/ChaseScore";
import TargetBoard from "../components/TargetBoard";
import StormMap from "../components/StormMap";
---

<Layout title="Storm IQ | Command">

  <section class="hero">

    <div class="hero-copy">

      <span class="hero-tag">
        NATIONWIDE STORM INTELLIGENCE
      </span>

      <h1>
        KNOW WHERE<br />
        <span style="color:var(--lime)">
          THE STORM
        </span><br />
        IS GOING.
      </h1>

      <p>
        Storm IQ combines official weather guidance,
        storm environments, timing, target scoring
        and safety information into one command
        dashboard for storm observers across the
        United States.
      </p>

    </div>


    <div class="card">

      <div class="eyebrow">
        System status
      </div>

      <h2 style="margin-top:7px">
        Monitoring
      </h2>

      <p class="muted">
        National weather environment online.
      </p>

      <div
        class="notice"
        style="margin-top:20px"
      >

        <strong>
          SAFETY FIRST
        </strong>

        <br />

        Storm IQ does not replace NWS warnings.
        If a warning conflicts with a target
        recommendation, follow the official
        warning and move to safety.

      </div>

    </div>

  </section>


  <div class="grid dashboard-grid">

    <ChaseScore client:only="react" />

    <TargetBoard client:only="react" />

  </div>


  <div
    class="grid two"
    style="margin-top:18px"
  >

    <div class="card">

      <div class="section-title">

        <div>

          <div class="eyebrow">
            National view
          </div>

          <h2>
            Live operations map
          </h2>

        </div>

        <span class="small muted">
          LIVE NWS + SPC
        </span>

      </div>

      <div class="map-shell">

        <StormMap client:only="react" />

      </div>

    </div>


    <div class="card">

      <div class="section-title">

        <div>

          <div class="eyebrow">
            Decision support
          </div>

          <h2>
            What’s live now
          </h2>

        </div>

      </div>


      <div class="alert">

        <strong>
          SPC Day 1 outlook
        </strong>

        <p>
          Categorical risk areas plus tornado and
          hail probability contours are plotted
          on the map.
        </p>

      </div>


      <div class="alert">

        <strong>
          Live radar + alerts
        </strong>

        <p>
          National NEXRAD reflectivity and active
          NWS warnings/watches update on load.
        </p>

      </div>


      <div class="alert">

        <strong>
          Safety override
        </strong>

        <p>
          Official warnings always take priority.
          Never use this dashboard in place of
          NWS warnings or local emergency guidance.
        </p>

      </div>


      <p
        class="small muted"
        style="margin-top:18px"
      >
        Next up: model parameters (CAPE, shear)
        and travel-time scoring. Current scores
        are derived from live alert severity +
        SPC risk.
      </p>

    </div>

  </div>

</Layout>
