---
import Layout from "../layouts/Layout.astro";
import ChaseScore from "../components/ChaseScore";
import TargetBoard from "../components/TargetBoard";
import StormMap from "../components/StormMap";
import ModelGuidance from "../components/ModelGuidance";
import HomeBase from "../components/HomeBase";
import LookingAhead from "../components/LookingAhead";
import UpcomingPotential from "../components/UpcomingPotential";
import FutureOutlookMap from "../components/FutureOutlookMap";
import FieldAlerts from "../components/FieldAlerts";
import GoNoGo from "../components/GoNoGo";
import ChaseRegions from "../components/ChaseRegions";
import ChaseWatch from "../components/ChaseWatch";
import MesoLinks from "../components/MesoLinks";
import CarFieldGuide from "../components/CarFieldGuide";
import ThreatStrip from "../components/ThreatStrip";
import QuietDay from "../components/QuietDay";
import ChaseTiming from "../components/ChaseTiming";
import ChaseLogPanel from "../components/ChaseLog";
import OfflineSnapPanel from "../components/OfflineSnap";
import DataExport from "../components/DataExport";
import WxConditions from "../components/WxConditions";
import LowSignalMode from "../components/LowSignalMode";
import VoiceReadouts from "../components/VoiceReadouts";
---

<Layout title="Storm IQ | Command">

  <section class="hero">
    <div class="hero-copy">
      <span class="hero-tag">NATIONWIDE STORM INTELLIGENCE</span>
      <h1>
        KNOW WHERE<br />
        <span style="color:var(--lime)">THE STORM</span><br />
        IS GOING.
      </h1>
      <p>
        Storm IQ combines official weather guidance, storm environments, timing,
        target scoring and safety information into one command dashboard for storm
        observers across the United States.
      </p>
    </div>

    <div class="card">
      <div class="eyebrow">System status</div>
      <h2 style="margin-top:7px">Monitoring</h2>
      <p class="muted">National weather environment online.</p>
      <div class="notice" style="margin-top:20px">
        <strong>SAFETY FIRST</strong><br />
        Storm IQ does not replace NWS warnings. If a warning conflicts with a target
        recommendation, follow the official warning and move to safety.
      </div>
    </div>
  </section>

  <ThreatStrip client:only="react" />
  <QuietDay client:only="react" />

  <div id="chase-timing" class="card" style="margin-bottom:18px;border-color:rgba(217,255,74,0.35)">
    <div class="section-title">
      <div>
        <div class="eyebrow">Chase day clock</div>
        <h2>Timing</h2>
      </div>
      <span class="small muted">WATCHES · WARNINGS · SPC</span>
    </div>
    <p class="muted" style="font-size:13px;line-height:1.55;margin:0 0 12px">
      Posture for the day (staging / in window), SPC Day 1 valid period, and
      severe watch–warning clocks.
    </p>
    <ChaseTiming client:only="react" />
  </div>

  <GoNoGo client:only="react" />

  <div id="home-base" class="card" style="margin-bottom:18px">
    <div class="section-title">
      <div>
        <div class="eyebrow">Your location</div>
        <h2>Home base</h2>
      </div>
      <span class="small muted">REQUIRED FOR WIND</span>
    </div>
    <p class="muted" style="font-size:13px;line-height:1.55;margin:0 0 10px">
      Set this first — wind, clouds, ETAs, voice, and near-me all use home base.
    </p>
    <HomeBase client:only="react" />
  </div>

  <div id="wind-clouds" class="card" style="margin-bottom:18px;border-color:rgba(82,224,208,0.4)">
    <div class="section-title">
      <div>
        <div class="eyebrow">Surface conditions</div>
        <h2>Wind &amp; clouds</h2>
      </div>
      <span class="small muted">AUTO 5 MIN</span>
    </div>
    <p class="muted" style="font-size:13px;line-height:1.55;margin:0 0 12px">
      Live wind, gusts, clouds, and precip at home base. Auto-refreshes ~5 minutes.
    </p>
    <WxConditions client:only="react" />
  </div>

  <LowSignalMode client:only="react" />
  <VoiceReadouts client:only="react" />

  <div class="grid two" style="margin-bottom:0">
    <ChaseLogPanel client:only="react" />
    <OfflineSnapPanel client:only="react" />
  </div>

  <DataExport client:only="react" />

  <div class="card" style="margin-bottom:18px;border-color:rgba(82,224,208,0.28)">
    <div class="section-title">
      <div>
        <div class="eyebrow">Your zones</div>
        <h2>Saved chase regions</h2>
      </div>
      <span class="small muted">PIN AREAS</span>
    </div>
    <p class="muted" style="font-size:13px;line-height:1.55;margin:0 0 10px">
      Pin Tornado Alley, Dixie, High Plains, or your home base.
    </p>
    <ChaseRegions client:only="react" />
  </div>

  <div class="card" style="margin-bottom:18px;border-color:rgba(217,255,74,0.3)">
    <div class="section-title">
      <div>
        <div class="eyebrow">Audio watch</div>
        <h2>Chase alert sounds</h2>
      </div>
      <span class="small muted">SOUNDS</span>
    </div>
    <p class="muted" style="font-size:13px;line-height:1.55;margin:0 0 10px">
      Look for <strong style="color:var(--lime)">ENABLE CHASE SOUNDS</strong>.
    </p>
    <ChaseWatch client:only="react" />
  </div>

  <div class="card" style="margin-bottom:18px;border-color:rgba(217,255,74,0.25)">
    <div class="section-title">
      <div>
        <div class="eyebrow">Field tools</div>
        <h2>Install &amp; near-me alerts</h2>
      </div>
      <span class="small muted">PWA</span>
    </div>
    <p class="muted" style="font-size:13px;line-height:1.55;margin:0 0 8px">
      Look for <strong style="color:var(--lime)">ENABLE NEAR-ME ALERTS</strong>.
    </p>
    <FieldAlerts client:only="react" />
  </div>

  <MesoLinks client:only="react" />
  <CarFieldGuide />

  <div class="grid dashboard-grid">
    <ChaseScore client:only="react" />
    <TargetBoard client:only="react" />
  </div>

  <div class="grid two" style="margin-top:18px">
    <div class="card">
      <div class="section-title">
        <div>
          <div class="eyebrow">National view</div>
          <h2>Live operations map</h2>
        </div>
        <span class="small muted">LIVE NWS + SPC</span>
      </div>
      <div class="map-shell">
        <StormMap client:only="react" />
      </div>
    </div>
    <ModelGuidance client:only="react" />
  </div>

  <UpcomingPotential client:only="react" />

  <div class="card" style="margin-top:18px" id="future-targets">
    <div class="section-title">
      <div>
        <div class="eyebrow">Looking ahead</div>
        <h2>Future target areas</h2>
      </div>
      <span class="small muted">DAY 2 / DAY 3 MAP</span>
    </div>
    <p class="muted" style="font-size:13px;line-height:1.55;margin:0 0 14px">
      Potential severe footprints for tomorrow and the day after.
    </p>
    <FutureOutlookMap client:only="react" />
  </div>

  <LookingAhead client:only="react" />

</Layout>
