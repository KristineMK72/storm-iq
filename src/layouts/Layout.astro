---
import "../styles/global.css";

const {
  title = "Storm IQ",
  description = "Live storm intelligence for safer storm observation — NWS alerts, SPC outlooks, radar, and chase targeting across the United States."
} = Astro.props;

const site = "https://storm-iq.vercel.app";
const ogImage = `${site}/og.svg`;
const path = Astro.url.pathname;

function isActive(href: string) {
  if (href === "/") return path === "/" || path === "";
  return path === href || path.startsWith(href + "/");
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta name="theme-color" content="#05090b" />
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Storm IQ" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={site} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/og.svg" />

    <title>{title}</title>
  </head>

  <body>
    <div class="app-shell">

      <header class="topbar">

        <a href="/" class="brand">
          <span class="brand-mark">⚡</span>
          <span>
            STORM <strong>IQ</strong>
          </span>
        </a>

        <nav class="desktop-nav">
          <a href="/" class={isActive("/") ? "nav-active" : ""}>Command</a>
          <a href="/map" class={isActive("/map") ? "nav-active" : ""}>Map</a>
          <a href="/targets" class={isActive("/targets") ? "nav-active" : ""}>Targets</a>
          <a href="/alerts" class={isActive("/alerts") ? "nav-active" : ""}>Alerts</a>
        </nav>

        <div class="live-pill">
          <span></span>
          LIVE
        </div>

        <button
          class="menu-btn"
          type="button"
          aria-label="Open menu"
          aria-expanded="false"
          id="menu-btn"
        >
          <span></span><span></span><span></span>
        </button>

      </header>

      <div class="mobile-nav" id="mobile-nav" hidden>
        <a href="/" class={isActive("/") ? "nav-active" : ""}>Command</a>
        <a href="/map" class={isActive("/map") ? "nav-active" : ""}>Map</a>
        <a href="/targets" class={isActive("/targets") ? "nav-active" : ""}>Targets</a>
        <a href="/alerts" class={isActive("/alerts") ? "nav-active" : ""}>Alerts</a>
      </div>

      <main>
        <slot />
      </main>

      <footer>
        <span>STORM IQ</span>
        <span>Official weather guidance always takes priority.</span>
      </footer>

    </div>

    <script is:inline>
      (function () {
        var btn = document.getElementById("menu-btn");
        var panel = document.getElementById("mobile-nav");
        if (!btn || !panel) return;
        btn.addEventListener("click", function () {
          var open = panel.hasAttribute("hidden");
          if (open) {
            panel.removeAttribute("hidden");
            btn.setAttribute("aria-expanded", "true");
            btn.classList.add("open");
          } else {
            panel.setAttribute("hidden", "");
            btn.setAttribute("aria-expanded", "false");
            btn.classList.remove("open");
          }
        });
      })();
    </script>
  </body>
</html>
